# Google Vertex / Gemini — images (Imagen), video (Veo 3.1), music (Lyria)
GEMINI_API_KEY=""
GOOGLE_VERTEX_PROJECT_ID=""
GOOGLE_VERTEX_LOCATION="us-central1"

# MusicAPI.ai — Suno-backed song generation
MUSICAPI_API_KEY=""
MUSICAPI_BASE_URL="https://api.musicapi.ai"

# Sunor (https://sunor.cc) — Suno V6 flagship music generation (`mus_suno_v6`)
SUNOR_API_KEY=""
SUNOR_BASE_URL="https://sunor.cc/api/v1"

# Supabase service role — REQUIRED for server-authoritative credits.
# Never expose this to the client bundle; it bypasses RLS.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Max variants any single request may ask for, regardless of model config
MAX_VARIANTS_HARD_CAP="4"

# Allowed CORS Origins for API (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,https://bidou.ai,https://www.bidou.ai"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FuturaPay Mobile Money API Configuration (MTN MoMo & Orange Money Cameroon)
FUTURAPAY_API_KEY=""
FUTURAPAY_MERCHANT_KEY=""
FUTURAPAY_SITE_ID=""
FUTURAPAY_API_BASE="https://api.futurapay.com"
FUTURAPAY_WEBHOOK_SECRET=""
FUTURAPAY_MERCHANT_ID=""

# Supabase Persistence Configuration (Unused until the Supabase adapter is enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# Multi-Supplier AI Providers & Dev/Prod Safety Caps (Phase 3)
# ==============================================================================
# Provider environment mode: 'dev' (enforces hard daily/total caps) or 'prod'
# (defaults to 'prod' only when NODE_ENV=production; forces 'dev' otherwise).
PROVIDER_ENV="dev"

# Cloudflare Workers AI — FLUX.1 Schnell & FLUX.2 Klein 4B image generation
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Kie.ai — Veo 3.1 primary video supplier (Lite, Fast, Quality 8s clips)
KIE_API_KEY=""

# Alibaba Cloud Model Studio (DashScope) — Wan 3.0 Standard & Prime (2–30s video)
# International accounts (Singapore) use https://dashscope-intl.aliyuncs.com
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com"

# Hard Dev-Mode Caps (checked against provider_cost_ledger before every call)
CF_DEV_DAILY_IMAGE_CAP="100"
GOOGLE_DEV_DAILY_IMAGE_CAP="10"
KIE_DEV_TOTAL_USD_CAP="0.40"
SUNOR_DEV_TOTAL_USD_CAP="0.50"
MUSICAPI_DEV_DAILY_TASK_CAP="3"
ALIBABA_DEV_DAILY_USD_CAP="1.00"
DEV_ALLOW_GOOGLE_VIDEO="false"

# Optional FX override for cost ledger XAF conversions (defaults to catalog 571.23)
FX_XAF_PER_USD="571.23"

# ==============================================================================
# Important domain note:
# If the application is accessed at https://bidou.ai in production and links to
# https://bidou.ai/?ref=... still result in a 404 or connection failure,
# please verify in your domain registrar / DNS provider and hosting service:
# 1. Ensure bidou.ai has valid A / CNAME DNS records pointing directly to your
#    deployment IP / Cloud Run / hosting service.
# 2. Confirm that the SSL/TLS certificate is provisioned and the production
#    deployment is actively published and mapped to custom domain bidou.ai.
# 3. Verify single-page app (SPA) fallback routing is enabled on your host/
#    reverse-proxy so query params like /?ref=CODE route to index.html.
# ==============================================================================
